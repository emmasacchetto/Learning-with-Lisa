
{
  "DIALOGUES": [
    {
      "id": "u8x_weather_week_plan",
      "category": "Unit 8 Fun Time - Choosing a Day",
      "vars": [],
      "lines": [
        {
          "speaker": "A",
          "eng": "I want to go sailing this week.",
          "spa": "Quiero ir a navegar esta semana.",
          "emoji": "⛵"
        },
        {
          "speaker": "B",
          "eng": "Check the weather chart first.",
          "spa": "Primero revisa la tabla del tiempo.",
          "emoji": "🌦️"
        },
        {
          "speaker": "A",
          "eng": "Wednesday is sunny and windy.",
          "spa": "El miércoles está soleado y ventoso.",
          "emoji": "💨"
        },
        {
          "speaker": "B",
          "eng": "That sounds good for sailing.",
          "spa": "Eso suena bien para navegar.",
          "emoji": "✅"
        },
        {
          "speaker": "A",
          "eng": "What can we do on the rainy day?",
          "spa": "¿Qué podemos hacer el día lluvioso?",
          "emoji": "🌧️"
        },
        {
          "speaker": "B",
          "eng": "We can visit a museum.",
          "spa": "Podemos visitar un museo.",
          "emoji": "🏛️"
        }
      ]
    },
    {
      "id": "u8x_sdg_planet_words",
      "category": "Unit 8 SDG - Protect Trees",
      "vars": [],
      "lines": [
        {
          "speaker": "A",
          "eng": "What happens when land is very dry?",
          "spa": "¿Qué pasa cuando la tierra está muy seca?",
          "emoji": "🏜️"
        },
        {
          "speaker": "B",
          "eng": "It can become a desert.",
          "spa": "Puede convertirse en un desierto.",
          "emoji": "☀️"
        },
        {
          "speaker": "A",
          "eng": "What are Everest and K2?",
          "spa": "¿Qué son el Everest y el K2?",
          "emoji": "🏔️"
        },
        {
          "speaker": "B",
          "eng": "They're mountains.",
          "spa": "Son montañas.",
          "emoji": "⛰️"
        },
        {
          "speaker": "A",
          "eng": "What takes water to the oceans?",
          "spa": "¿Qué lleva agua a los océanos?",
          "emoji": "🌊"
        },
        {
          "speaker": "B",
          "eng": "Rivers do.",
          "spa": "Los ríos.",
          "emoji": "🏞️"
        }
      ]
    },
    {
      "id": "fp_litter_school",
      "category": "Final Project - Litter near school",
      "vars": [],
      "lines": [
        {
          "speaker": "A",
          "eng": "What litter do you usually see near school?",
          "spa": "¿Qué basura sueles ver cerca de la escuela?",
          "emoji": "🗑️"
        },
        {
          "speaker": "B",
          "eng": "I often see plastic bottles and crisp packets.",
          "spa": "A menudo veo botellas de plástico y paquetes de papas fritas.",
          "emoji": "🥤"
        },
        {
          "speaker": "A",
          "eng": "Do you see broken glass?",
          "spa": "¿Ves vidrios rotos?",
          "emoji": "🟩"
        },
        {
          "speaker": "B",
          "eng": "Sometimes, but not very often.",
          "spa": "A veces, pero no muy seguido.",
          "emoji": "⚠️"
        },
        {
          "speaker": "A",
          "eng": "We should organise a litter pick.",
          "spa": "Deberíamos organizar una jornada de recolección de basura.",
          "emoji": "🧤"
        },
        {
          "speaker": "B",
          "eng": "Good idea!",
          "spa": "¡Buena idea!",
          "emoji": "👍"
        }
      ]
    },
    {
      "id": "fp_litter_equipment",
      "category": "Final Project - Equipment",
      "vars": [],
      "lines": [
        {
          "speaker": "A",
          "eng": "What equipment do we need?",
          "spa": "¿Qué equipo necesitamos?",
          "emoji": "🎒"
        },
        {
          "speaker": "B",
          "eng": "We need bags and gloves.",
          "spa": "Necesitamos bolsas y guantes.",
          "emoji": "🧤"
        },
        {
          "speaker": "A",
          "eng": "Should we take boots?",
          "spa": "¿Deberíamos llevar botas?",
          "emoji": "🥾"
        },
        {
          "speaker": "B",
          "eng": "Yes, especially if the ground is wet.",
          "spa": "Sí, especialmente si el suelo está mojado.",
          "emoji": "💧"
        },
        {
          "speaker": "A",
          "eng": "Do we need a map and a phone?",
          "spa": "¿Necesitamos un mapa y un teléfono?",
          "emoji": "🗺️"
        },
        {
          "speaker": "B",
          "eng": "They can be useful too.",
          "spa": "También pueden ser útiles.",
          "emoji": "📱"
        }
      ]
    },
    {
      "id": "fp_litter_poster",
      "category": "Final Project - Planning a poster",
      "vars": [],
      "lines": [
        {
          "speaker": "A",
          "eng": "When is our litter pick?",
          "spa": "¿Cuándo es nuestra jornada de limpieza?",
          "emoji": "📅"
        },
        {
          "speaker": "B",
          "eng": "On Saturday morning.",
          "spa": "El sábado por la mañana.",
          "emoji": "🌅"
        },
        {
          "speaker": "A",
          "eng": "Where is it?",
          "spa": "¿Dónde es?",
          "emoji": "📍"
        },
        {
          "speaker": "B",
          "eng": "At Riverside Park.",
          "spa": "En Riverside Park.",
          "emoji": "🌳"
        },
        {
          "speaker": "A",
          "eng": "What should we put on the poster?",
          "spa": "¿Qué deberíamos poner en el póster?",
          "emoji": "🖼️"
        },
        {
          "speaker": "B",
          "eng": "The date, time, place and equipment.",
          "spa": "La fecha, la hora, el lugar y el equipo necesario.",
          "emoji": "📝"
        }
      ]
    },
    {
      "id": "fp_litter_group",
      "category": "Final Project - Group work",
      "vars": [],
      "lines": [
        {
          "speaker": "A",
          "eng": "Which poster do you prefer?",
          "spa": "¿Qué póster prefieres?",
          "emoji": "🖼️"
        },
        {
          "speaker": "B",
          "eng": "Poster B. The information is clear and the pictures are useful.",
          "spa": "El póster B. La información es clara y las imágenes son útiles.",
          "emoji": "✅"
        },
        {
          "speaker": "A",
          "eng": "What can we improve?",
          "spa": "¿Qué podemos mejorar?",
          "emoji": "💡"
        },
        {
          "speaker": "B",
          "eng": "We can make the time bigger and add the equipment list.",
          "spa": "Podemos hacer la hora más grande y agregar la lista de equipo.",
          "emoji": "📝"
        },
        {
          "speaker": "A",
          "eng": "Do we all agree?",
          "spa": "¿Estamos todos de acuerdo?",
          "emoji": "🤝"
        },
        {
          "speaker": "B",
          "eng": "Yes. Let's finish it together.",
          "spa": "Sí. Terminémoslo juntos.",
          "emoji": "👥"
        }
      ]
    }
  ]
}
